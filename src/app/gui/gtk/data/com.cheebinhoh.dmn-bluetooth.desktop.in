[Desktop Entry]
Name=Dmn Bluetooth
GenericName=Bluetooth Device Monitor
Comment=Select a Bluetooth device for monitoring
Exec=dmn-bluetooth-gtk
Icon=@DMN_BLUETOOTH_GTK_APP_ID@
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
DBusActivatable=true
X-GNOME-UsesNotifications=true
