[Desktop Entry]
Name=Dmn Bluetooth
GenericName=Bluetooth Device Monitor
Comment=Select a Bluetooth device for monitoring
Exec=@CMAKE_INSTALL_FULL_BINDIR@/dmn-bluetooth-gtk
TryExec=@CMAKE_INSTALL_FULL_BINDIR@/dmn-bluetooth-gtk
