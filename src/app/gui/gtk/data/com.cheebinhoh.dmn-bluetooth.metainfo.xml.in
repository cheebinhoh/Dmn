<component type="desktop-application">
  <id>@DMN_BLUETOOTH_GTK_APP_ID@</id>
  <name>Dmn Bluetooth</name>
  <summary>Monitor iPhone notifications over Bluetooth</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="com.cheebinhoh">
    <name>Chee Bin Hoh</name>
  </developer>
  <categories>
    <category>Utility</category>
  </categories>
  <releases>
    <release version="@PROJECT_VERSION@" date="2026-10-27" type="stable" />
  </releases>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">none</content_attribute>
  </content_rating>
  <description>
    <p>
      Discover Bluetooth devices, choose which paired iPhones to connect, and
      explicitly start monitoring notifications shared through Apple's
      Notification Center Service (ANCS).
    </p>
    <p>
      Notification events are shown in a temporary in-app feed and are kept
      only in memory for the current session. The app does not retrieve older
      notifications or continue monitoring after it quits.
    </p>
  </description>
  <launchable type="desktop-id">@DMN_BLUETOOTH_GTK_APP_ID@.desktop</launchable>
  <provides>
    <binary>dmn-bluetooth-gtk</binary>
  </provides>
  <url type="homepage">https://github.com/cheebinhoh/Dmn</url>
  <url type="bugtracker">https://github.com/cheebinhoh/Dmn/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>Select a paired iPhone and monitor its notifications</caption>
      <image type="source">https://raw.githubusercontent.com/cheebinhoh/Dmn/main/packaging/flatpak/screenshots/dmn-bluetooth-gtk%2B-app.png</image>
    </screenshot>
    <screenshot>
      <caption>About Dmn Bluetooth</caption>
      <image type="source">https://raw.githubusercontent.com/cheebinhoh/Dmn/main/packaging/flatpak/screenshots/dmn-bluetooth-gtk%2B-app-about.png</image>
    </screenshot>
  </screenshots>
  <icon type="stock">@DMN_BLUETOOTH_GTK_APP_ID@</icon>
</component>
